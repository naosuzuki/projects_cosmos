# SExtractor config — LS DR10 z.  Sibling of lsdr10_g.sex; reddest band,
# target for LS DR10 χ²+ stack PSF homogenization.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   8,12,20
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10
MAG_ZEROPOINT    22.5
MAG_GAMMA        4.0
GAIN             4.0
PIXEL_SCALE      0.262
SEEING_FWHM      1.0
STARNNW_NAME     default.nnw
BACK_SIZE        64
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
