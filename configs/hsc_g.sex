# SExtractor config — Subaru HSC g (SSP s23b deep2 deepCoadd_calexp).
#
# Notes:
#   HSC native pixel scale 0.168".  Deep+UltraDeep seeing is well-
#   controlled (~0.55-0.75" FWHM in g); set 0.65" as a default.
#   ZP_AB = 27.0 by HSC SSP convention (FLUXMAG0 = 10^(0.4×27)).

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   12,18,30      # 2.0", 3.0", 5.0" at 0.168"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      65000.0
MAG_ZEROPOINT    27.0          # HSC SSP convention
MAG_GAMMA        4.0
GAIN             3.0
PIXEL_SCALE      0.168
SEEING_FWHM      0.65
STARNNW_NAME     default.nnw
BACK_SIZE        64
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
