# SExtractor config — HST ACS WFC F814W (COSMOS-Web 30 mas
# Koekemoer rereduction; HST_2005 epoch).
#
# Notes:
#   ACS WFC native pixel scale 0.05"; the Koekemoer COSMOS-Web 30 mas
#   rereduction drizzles to 30 mas matching the JWST grid, so for v04
#   we use 0.030.  PSF FWHM at 30 mas drizzle is ~0.10" (~3.3 pix).
#   ZP_AB depends on the rereduction's ABMAG_ZP keyword
#   (typical F814W AB ZP is 25.937 for the Koekemoer chain).

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  64
DEBLEND_MINCONT  0.0005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   10,17,33      # 0.3", 0.5", 1.0"
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10
SATUR_KEY        SATURATE
MAG_ZEROPOINT    25.937        # OVERRIDDEN per-image from ABMAG_ZP/PHOTFLAM
MAG_GAMMA        4.0
GAIN             0.0
PIXEL_SCALE      0.030
SEEING_FWHM      0.100
STARNNW_NAME     default.nnw
BACK_SIZE        128
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
