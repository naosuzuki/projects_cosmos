# SExtractor config — LS DR10 (DECaLS south) g band coadd brick.
#
# LS DR10 convention:
#   Pixel scale 0.262"/pix.  Bricks are 3600×3600 px = ~16' × 16'.
#   Pixel values in nMgy (linear flux), AB ZP = 22.5 + 2.5*log10(NMGY).
#   In DR10, fluxes already in nMgy; AB ZP = 22.5.
#   PSF FWHM 1.0-1.3" depending on band/observing conditions.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   8,12,20       # 2", 3", 5" at 0.262"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10
MAG_ZEROPOINT    22.5
MAG_GAMMA        4.0
GAIN             4.0
PIXEL_SCALE      0.262
SEEING_FWHM      1.3
STARNNW_NAME     default.nnw
BACK_SIZE        64
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
