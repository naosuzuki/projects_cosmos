# SExtractor config — GALEX FUV (~1540 Å) intensity map.
#
# GALEX intensity-map convention:
#   Pixel scale 1.5"/pix.  Tiles are 3840×3840 px = 96' × 96'.
#   Units: counts/sec.  AB ZP for FUV = 18.82.
#   PSF FWHM ~4.5" FUV.
#   The PHOT_APERTURES are LARGE (3-12") matching GALEX point-source
#   recommendations.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   3
DETECT_THRESH    2.0
ANALYSIS_THRESH  2.0
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  16
DEBLEND_MINCONT  0.01
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      NONE
PHOT_APERTURES   3,6,8         # 4.5", 9", 12" at 1.5"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1000.0
MAG_ZEROPOINT    18.82
MAG_GAMMA        4.0
GAIN             1.0
PIXEL_SCALE      1.500
SEEING_FWHM      4.5
STARNNW_NAME     default.nnw
BACK_SIZE        16
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   GLOBAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
