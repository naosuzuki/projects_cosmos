# SExtractor config — Pan-STARRS1 DR1 rings.v3 skycell stack, g band.
# 0.25"/px, seeing ~1.0-1.3"; image un-asinh-scaled to LINEAR counts by the
# builder; ZP = 25 + 2.5log10(EXPTIME) overridden per cell at runtime.
# GAIN 0: stack counts, sky-noise-dominated error model (validated WEIGHT
# NONE ground recipe); saturation via the mask SAT bit in the builder.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      NONE
WEIGHT_THRESH    0
WEIGHT_GAIN      N
PHOT_APERTURES   12,18,30
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1e9
MAG_ZEROPOINT    25.0
MAG_GAMMA        4.0
GAIN             0.0
PIXEL_SCALE      0.25
SEEING_FWHM      1.2
STARNNW_NAME     default.nnw
BACK_SIZE        64
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
