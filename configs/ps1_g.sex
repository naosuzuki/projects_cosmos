# SExtractor config — Pan-STARRS 1 (DR1 rings.v3 stack) g band.
#
# PS1 stack convention:
#   Pixel scale 0.25"/pix.  Tiles are 6240×6243 px = 0.4° × 0.4°.
#   FLUXMAG0 = 10^(0.4×25) → AB ZP = 25.0 (e.g. AB_mag = -2.5*log10(flux) + 25)
#   PSF FWHM ~1.0-1.2" depending on band; stacks have homogenized PSF.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   8,12,20       # 2", 3", 5" at 0.25"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10        # stack is float
MAG_ZEROPOINT    25.0
MAG_GAMMA        4.0
GAIN             1.0
PIXEL_SCALE      0.250
SEEING_FWHM      1.2
STARNNW_NAME     default.nnw
BACK_SIZE        64
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
