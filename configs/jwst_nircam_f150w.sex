# SExtractor config — JWST NIRCam F150W (COSMOS-Web 30mas mosaics)
# Sibling of jwst_nircam_f115w.sex.  Differences from F115W:
#   SEEING_FWHM scaled to F150W diffraction limit ~0.060" → wrapper
#     overrides from PSFEx-measured value (~2.7 pix at 30 mas).
#   PSFEx + ZP_AB are computed from the header at runtime.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   5
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  64
DEBLEND_MINCONT  0.0005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   10,17,33      # 0.3", 0.5", 1.0" diameters at 0.030"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10
SATUR_KEY        SATURATE
MAG_ZEROPOINT    28.08         # OVERRIDDEN per-tile from PIXAR_SR
MAG_GAMMA        4.0
GAIN             0.0
GAIN_KEY         GAIN
PIXEL_SCALE      0.030
SEEING_FWHM      0.060         # F150W diffraction limit
STARNNW_NAME     default.nnw
BACK_SIZE        128
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
