# SExtractor config — unWISE NEO7 fulldepth W1 coadd (~3.4 µm).
#
# unWISE NEO7 fulldepth convention:
#   Pixel scale 2.75"/pix.  Tiles 2048×2048 = 1.564° × 1.564°.
#   img-m units: counts/sec.  W1 5σ Vega ~19.6 (≈21.3 AB).
#   Vega → AB: W1_AB = W1_Vega + 2.699; W2_AB = W2_Vega + 3.339.
#   Default ZP here in AB for W1: typical ~22.5 for unWISE NEO7.
#   PSF FWHM ~6" W1.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   3
DETECT_THRESH    2.0
ANALYSIS_THRESH  2.0
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  16
DEBLEND_MINCONT  0.01
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   2,3,4         # 5.5", 8.25", 11" at 2.75"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10
MAG_ZEROPOINT    22.5
MAG_GAMMA        4.0
GAIN             1.0
PIXEL_SCALE      2.750
SEEING_FWHM      6.0
STARNNW_NAME     default.nnw
BACK_SIZE        16
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   GLOBAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
