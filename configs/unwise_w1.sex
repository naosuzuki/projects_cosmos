# SExtractor config — unWISE neo7 fulldepth coadd, w1 band.
# 2.75"/px (PSF FWHM ~6" = 2.2 px, marginally sampled); MAGZP 22.5 VEGA ->
# builder overrides with AB (W1 +2.699, W2 +3.339).  GAIN 0: coadd counts,
# background-RMS noise model (validated WEIGHT NONE ground recipe).
# No mask plane: saturation via the ~110k-count ceiling in the builder.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   4
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      NONE
WEIGHT_THRESH    0
WEIGHT_GAIN      N
PHOT_APERTURES   6,10,16
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1e9
MAG_ZEROPOINT    25.199
MAG_GAMMA        4.0
GAIN             0.0
PIXEL_SCALE      2.75
SEEING_FWHM      6.0
STARNNW_NAME     default.nnw
BACK_SIZE        64
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  12
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
