# SExtractor config — JWST NIRCam χ² detection image, HOT pass.
#
# Adopts Shuntov+ 2025 (COSMOS2025 / COSMOS-Web galaxy catalog,
# A&A 2025) parameters where specified, with CANDELS Galametz+ 2013
# (ApJS 207, 24) values filling unspecified entries.  Light smoothing
# + small background mesh + aggressive deblending → detects faint,
# compact sources that the cold pass missed.
#
# Merging downstream: hot sources whose centroids lie inside any cold
# source's Kron ellipse are discarded as cold-substructure.

#-------------------------------- Catalog ------------------------------------
CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default_pass1.param

#------------------------------- Extraction ----------------------------------
DETECT_TYPE      CCD
DETECT_MINAREA   8                      # Shuntov 2025
DETECT_THRESH    3.0                    # 3σ on χ²+ image, Shuntov 2025
ANALYSIS_THRESH  0.8                    # CANDELS Galametz 2013
FILTER           Y
FILTER_NAME      gauss_3.0_5x5.conv     # Shuntov — gaussian 3-pix FWHM
DEBLEND_NTHRESH  32                     # Shuntov 2025
DEBLEND_MINCONT  0.01                   # Shuntov 2025
CLEAN            Y
CLEAN_PARAM      0.5                    # Shuntov 2025
MASK_TYPE        CORRECT

#------------------------------ Weighting ------------------------------------
WEIGHT_TYPE      NONE
WEIGHT_GAIN      N

#------------------------------ Photometry -----------------------------------
PHOT_APERTURES   10,17,33
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e9
MAG_ZEROPOINT    30.0
MAG_GAMMA        4.0
GAIN             0.0
PIXEL_SCALE      0.030

#------------------------- Star/Galaxy Separation ----------------------------
SEEING_FWHM      0.145
STARNNW_NAME     default.nnw

#------------------------------ Background -----------------------------------
BACK_SIZE        128                    # CANDELS — smaller mesh
BACK_FILTERSIZE  5                      # CANDELS
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  48                     # CANDELS

#------------------------------ Check images ---------------------------------
CHECKIMAGE_TYPE  SEGMENTATION
CHECKIMAGE_NAME  seg_hot.fits

#--------------------- Memory ------------------------------------------------
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  2000000
MEMORY_BUFSIZE   4096

#----------------------------- Miscellaneous ---------------------------------
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
