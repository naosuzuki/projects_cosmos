# SExtractor config — GALEX NUV (~2300 Å) intensity map.
# Sibling of galex_fuv.sex; broader PSF (~5.5"); AB ZP = 20.08.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   3
DETECT_THRESH    2.0
ANALYSIS_THRESH  2.0
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  16
DEBLEND_MINCONT  0.01
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      NONE
PHOT_APERTURES   3,6,8
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1000.0
MAG_ZEROPOINT    20.08
MAG_GAMMA        4.0
GAIN             1.0
PIXEL_SCALE      1.500
SEEING_FWHM      5.5
STARNNW_NAME     default.nnw
BACK_SIZE        16
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   GLOBAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
