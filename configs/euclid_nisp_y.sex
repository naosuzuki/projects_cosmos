# SExtractor config — Euclid NISP Y (DR1 MER mosaics, 0.30"/pix).
#
# Notes:
#   NISP Y native pixel scale 0.30".  PSF FWHM ~0.4-0.45".
#   The MER pipeline resamples NISP onto a VIS-aligned 0.10" or
#   0.30" grid per tile (check header).  For SExtractor the
#   PIXEL_SCALE here is the EFFECTIVE pixel scale of the input image.

CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param
DETECT_TYPE      CCD
DETECT_MINAREA   4
DETECT_THRESH    1.5
ANALYSIS_THRESH  1.5
FILTER           Y
FILTER_NAME      default.conv
DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005
CLEAN            Y
CLEAN_PARAM      1.0
MASK_TYPE        CORRECT
WEIGHT_TYPE      MAP_WEIGHT
WEIGHT_THRESH    0
WEIGHT_GAIN      Y
PHOT_APERTURES   5,10,15       # 1.5", 3", 4.5" at 0.30"/pix
PHOT_AUTOPARAMS  2.5,3.5
PHOT_PETROPARAMS 2.0,3.5
SATUR_LEVEL      1.0e10
MAG_ZEROPOINT    24.50         # OVERRIDDEN per-mosaic from header ZP
MAG_GAMMA        4.0
GAIN             0.0
PIXEL_SCALE      0.300
SEEING_FWHM      0.450
STARNNW_NAME     default.nnw
BACK_SIZE        32
BACK_FILTERSIZE  3
BACKPHOTO_TYPE   LOCAL
BACKPHOTO_THICK  24
CHECKIMAGE_TYPE  NONE
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  1000000
MEMORY_BUFSIZE   4096
VERBOSE_TYPE     NORMAL
WRITE_XML        N
NTHREADS         0
PSF_NAME         psf.psf
PSF_NMAX         1
PATTERN_TYPE     RINGS-HARMONIC
